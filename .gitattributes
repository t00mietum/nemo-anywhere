# Shell scripts must stay LF so they run under MSYS2 bash on Windows too
# (autocrlf would otherwise hand them CRLF on a Windows checkout and break them).
*.bash text eol=lf
*.sh   text eol=lf

# Git hooks are shell too, just without an extension to match on.
cicd/hooks/* text eol=lf

# Vendored theme art - keep bytes stable, no EOL conversion.
*.svg -text
*.png -text

field: preferences.menu-config.selection-menu-compress
	type: bool
	default: true
	desc: Show the selection context menu's Compress item.

field: preferences.menu-config.selection-menu-copy
	type: bool
	default: true
	desc: Show the selection context menu's Copy item.

field: preferences.menu-config.selection-menu-copy-to
	type: bool
	default: false
	desc: Show the selection context menu's Copy To submenu.

field: preferences.menu-config.selection-menu-copy-path
	type: bool
	default: true
	desc: Show the selection context menu's Copy Path item.

field: preferences.menu-config.selection-menu-cut
	type: bool
	default: true

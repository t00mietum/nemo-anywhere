# Schema for the nemo-anywhere config file.
# Declares every setting's type, default and (where closed) allowed values.
# Plain SHCL - nothing compiles it. See vendor/shcl for the language.

field: favorites
	type: string-array
	desc: Favorite files and folders

field: favorites-root-metadata
	type: string-array
	desc: Metadata for the favorites root

field: appearance.gtk-theme
	type: string
	default: 
	desc: Widget theme to use, or empty to leave it to the platform

field: appearance.icon-theme
	type: string
	default: 
	desc: Icon theme to use, or empty to leave it to the platform

field: appearance.mode
	type: string
	allowed: system, light, dark
	default: system
	desc: Light or dark appearance, or follow the system

field: archive.create-with-7z
	type: string
	default: "{{PROGRAM}} a {{FORMAT}} {{LEVEL}} {{THREADS}} -y -bsp1 {{PASSWORD}} {{SPLIT}} {{SOLID}} {{LINKS}} -- {{TARGET_ARCHIVE}} {{SOURCE_ITEMS}}"
	desc: Command line 7-Zip is run with to create an archive. {{PROGRAM}} is the 7z it found, {{SOURCE_ITEMS}} the files and folders being packed, and the rest stand for what the Compress dialog was asked for - drop one and that option stops reaching the program. Empty this line to get the built-in one back.

field: archive.create-with-rar
	type: string
	default: "{{PROGRAM}} a {{LEVEL}} {{THREADS}} -r -y {{PASSWORD}} {{SPLIT}} {{SOLID}} {{DEDUPE}} {{RECOVERY}} {{LOCK}} {{LINKS}} -- {{TARGET_ARCHIVE}} {{SOURCE_ITEMS}}"
	desc: Command line rar is run with to create an archive. Same placeholders as the 7-Zip line, plus {{DEDUPE}}, {{RECOVERY}} and {{LOCK}}, which rar alone can do.

field: archive.extract-with-7z
	type: string
	default: "{{PROGRAM}} x -y -bsp1 {{PASSWORD}} -o{{TARGET_FOLDER}} -- {{SOURCE_ARCHIVE}}"
	desc: Command line 7-Zip is run with to unpack an archive it was reached for. {{PASSWORD}} is answered either way, since a prompt would wait on a console that is not there.

field: archive.extract-with-rar
	type: string
	default: "{{PROGRAM}} x -y {{PASSWORD}} -- {{SOURCE_ARCHIVE}} {{TARGET_FOLDER_WITH_SEPARATOR}}"
	desc: Command line rar or unrar is run with to unpack an archive. {{TARGET_FOLDER_WITH_SEPARATOR}} is the destination with a trailing separator, which is how rar tells it from an archive name.

field: compact-view.all-columns-have-same-width
	type: bool
	default: false
	desc: All columns have same width

field: compact-view.default-zoom-level
	type: string
	allowed: smallest, smaller, small, standard, large, larger, largest
	default: standard
	desc: Default compact view zoom level

field: interface.clock-use-24h
	type: bool
	default: true

field: media-handling.automount
	type: bool
	default: false

field: media-handling.automount-open
	type: bool
	default: false

field: performance.cpu-percent
	type: int
	default: 50
	desc: Percentage of the machine's CPU cores any compression may use. 50% is the best balance for hyperthreaded CPUs. Rounds up, so there is always at least one.

field: privacy.remember-recent-files
	type: bool
	default: true

field: terminal.exec
	type: string
	default: ""

field: terminal.exec-arg
	type: string
	default: -e

field: terminal.win32-candidates
	type: string-array
	default: wt.exe, pwsh.exe, powershell.exe, cmd.exe
	desc: Terminals to try for "Open in Terminal" on Windows, in order

field: desktop.show-desktop-icons
	type: bool
	default: true
	desc: Deprecated: Allow Nemo to manage the desktop

field: desktop.text-ellipsis-limit
	type: int
	default: 2
	desc: Text Ellipsis Limit

field: desktop.use-desktop-grid
	type: bool
	default: true
	desc: Which desktop view type to use

field: icon-view.captions
	type: string-array
	default: none, size, date_modified
	desc: List of possible captions on icons

field: icon-view.default-use-tighter-layout
	type: bool
	default: false
	desc: deprecated - not used

field: icon-view.default-zoom-level
	type: string
	allowed: smallest, smaller, small, standard, large, larger, largest
	default: standard
	desc: Default icon zoom level

field: icon-view.labels-beside-icons
	type: bool
	default: false
	desc: Put labels beside icons

field: icon-view.text-ellipsis-limit
	type: string-array
	default: 3
	desc: Text Ellipsis Limit

field: icon-view.thumbnail-size
	type: int
	default: 64
	desc: Default Thumbnail Icon Size

field: list-view.column-max-widths
	type: string-array
	desc: Per-column width ceilings the user set by dragging, as column:pixels entries. A listed column never grows past its ceiling as the window widens.

field: list-view.default-column-order
	type: string-array
	default: name, where, size, extension, type, date_modified, owner, group, permissions
	desc: Default column order in the list view

field: list-view.default-visible-columns
	type: string-array
	default: name, size, extension, type, date_modified, owner, group, permissions
	desc: Default list of columns visible in the list view

field: list-view.default-zoom-level
	type: string
	allowed: smallest, smaller, small, standard, large, larger, largest
	default: small
	desc: Default list zoom level

field: list-view.enable-folder-expansion
	type: bool
	default: true
	desc: If true, allow folders with content to be expanded in the current view.

field: plugins.disabled-actions
	type: string-array
	desc: List of NemoActions -not- to load.

field: plugins.disabled-extensions
	type: string-array
	desc: List of extensions -not- to load.

field: plugins.disabled-scripts
	type: string-array
	desc: List of scripts -not- to load.

field: preferences.always-use-browser
	type: bool
	default: true
	desc: Enables the classic Nemo behavior, where all windows are browsers

field: preferences.bulk-rename-tool
	type: string
	default: ""
	desc: Bulk rename utility

field: preferences.click-double-parent-folder
	type: bool
	default: false
	desc: If true, double click left on blank area will go to parent folder

field: preferences.click-policy
	type: string
	allowed: single, double
	default: double
	desc: Type of click used to launch/open files

field: preferences.close-device-view-on-device-eject
	type: bool
	default: false
	desc: Whether to close a view of a removeable device instead of navigating Home

field: preferences.confirm-move-to-trash
	type: bool
	default: true
	desc: Whether to ask for confirmation when moving files to Trash

field: preferences.confirm-trash
	type: bool
	default: true
	desc: Whether to ask for confirmation when deleting files, or emptying Trash

field: preferences.context-menus-show-all-actions
	type: bool
	default: false
	desc: deprecated - no longer used

field: preferences.date-format
	type: string
	allowed: locale, iso, informal
	default: iso
	desc: Date Format

field: preferences.default-folder-viewer
	type: string
	allowed: icon-view, compact-view, list-view
	default: list-view
	desc: Default folder viewer

field: preferences.default-sort-in-reverse-order
	type: bool
	default: false
	desc: Reverse sort order in new windows

field: preferences.default-sort-order
	type: string
	allowed: manually, name, size, type, detailed_type, mtime, atime, trash-time
	default: name
	desc: Default sort order

field: preferences.deferred-attribute-preload-limit
	type: int
	default: 150
	desc: Maximum number of files to preload deferred attributes for when opening a directory

field: preferences.desktop-is-home-dir
	type: bool
	default: false
	desc: Nemo uses the users home folder as the desktop

field: preferences.detect-content
	type: bool
	default: false
	desc: If true, enable detection of the type of content of a mounted media and display a suggested application to open the media.

field: preferences.disable-menu-warning
	type: bool
	default: false
	desc: Don't show the explainer message when turning off the main menu

field: preferences.enable-delete
	type: bool
	default: true
	desc: Whether to enable immediate deletion

field: preferences.enable-mime-actions-make-executable
	type: bool
	default: false
	desc: Display the 'Make executable and run' button in the mime-action dialog (open an unknown filetype)

field: preferences.executable-text-activation
	type: string
	allowed: launch, display, ask
	default: ask
	desc: What to do with executable text files when activated

field: preferences.expand-row-on-dnd-dwell
	type: bool
	default: true
	desc: During drag-and-drop operations, automatically expand rows when hovering them briefly

field: preferences.ignore-view-metadata
	type: bool
	default: false
	desc: Whether to ignore folder metadata for view zoom levels and layouts

field: preferences.image-viewers-with-external-sort
	type: string-array
	default: xviewer, feh, sxiv
	desc: Image viewer executables to pass sort order to

field: preferences.inherit-folder-viewer
	type: bool
	default: false
	desc: Inherit the view type (icon, compact, list) from parent to children

field: preferences.inherit-show-thumbnails
	type: bool
	default: true
	desc: Inherit thumbnail visibility from parent

field: preferences.last-server-connect-method
	type: int
	default: 2
	desc: Last server connect method used

field: preferences.mouse-back-button
	type: int
	default: 8
	desc: Mouse button to activate the "Back" command in browser window

field: preferences.mouse-forward-button
	type: int
	default: 9
	desc: Mouse button to activate the "Forward" command in browser window

field: preferences.mouse-use-extra-buttons
	type: bool
	default: true
	desc: Use extra mouse button events in Nemo' browser window

field: preferences.never-queue-file-ops
	type: bool
	default: false
	desc: If true, all file operations will start immediately

field: preferences.rename-selects-whole-name
	type: bool
	default: true
	desc: Whether starting a rename selects the whole name. False selects only the part before the extension, which is what most file managers do.

field: preferences.quick-renames-with-pause-in-between
	type: bool
	default: false
	desc: Enables renaming of icons by two times clicking with pause between clicks

field: preferences.show-advanced-permissions
	type: bool
	default: false
	desc: Show advanced permissions in the file property dialog

field: preferences.show-bookmarks-in-to-menus
	type: bool
	default: true
	desc: Whether to list bookmarks in the Move To/Copy To menus

field: preferences.show-compact-view-icon-toolbar
	type: bool
	default: true
	desc: Show Compact View button in nemo toolbar

field: preferences.path-separator
	type: string
	allowed: backslash, slash
	default: backslash
	desc: Which separator paths are shown with (Windows only; elsewhere there is only one)

field: preferences.allow-slash-input
	type: bool
	default: true
	desc: Whether a forward slash counts as a separator in a typed location (Windows only)

field: preferences.show-computer-icon-toolbar
	type: bool
	default: false
	desc: Show Computer button in nemo toolbar

field: preferences.show-directory-item-counts
	type: string
	allowed: always, local-only, never
	default: local-only
	desc: When to show number of items in a folder

field: preferences.show-edit-icon-toolbar
	type: bool
	default: true
	desc: Show toggle button location entry/pathbar

field: preferences.show-full-path-titles
	type: bool
	default: false
	desc: Whether to show the full path of the current view in the title bar and tab bars

field: preferences.show-dot-files
	type: bool
	default: false
	desc: Whether to show files whose name starts with a dot (Windows only; elsewhere they count as hidden files)

field: preferences.show-hidden-files
	type: bool
	default: false
	desc: Whether to show hidden files

field: preferences.show-home-icon-toolbar
	type: bool
	default: false
	desc: Show Home button in nemo toolbar

field: preferences.show-icon-view-icon-toolbar
	type: bool
	default: true
	desc: Show Icon View button in nemo toolbar

field: preferences.show-image-thumbnails
	type: string
	allowed: always, local-only, never
	default: local-only
	desc: When to show thumbnails of image files

field: preferences.show-list-view-icon-toolbar
	type: bool
	default: true
	desc: Show List View button in nemo toolbar

field: preferences.show-location-entry
	type: bool
	default: false
	desc: Show the location entry by default

field: preferences.show-new-folder-icon-toolbar
	type: bool
	default: false
	desc: Show new folder button in nemo toolbar

field: preferences.show-next-icon-toolbar
	type: bool
	default: true
	desc: Show Next button in nemo toolbar

field: preferences.show-open-in-terminal-toolbar
	type: bool
	default: false
	desc: Show open in terminal in the nemo toolbar

field: preferences.show-places-in-to-menus
	type: bool
	default: true
	desc: Whether to list places in the Move To/Copy To menus

field: preferences.show-previous-icon-toolbar
	type: bool
	default: true
	desc: Show Previous button in nemo toolbar

field: preferences.show-reload-icon-toolbar
	type: bool
	default: false
	desc: Show refresh button in nemo toolbar

field: preferences.show-root-warning
	type: bool
	default: true
	desc: Show warning when opening as root

field: preferences.show-search-icon-toolbar
	type: bool
	default: true
	desc: Show Search button in nemo toolbar

field: preferences.show-shortcut-extension
	type: bool
	default: false
	desc: Whether a shortcut's .lnk or .desktop extension is part of the name shown

field: preferences.show-show-thumbnails-toolbar
	type: bool
	default: false
	desc: Show Thumbnails button in nemo toolbar

field: preferences.show-toggle-extra-pane-toolbar
	type: bool
	default: false
	desc: Show Extra Pane button in nemo toolbar

field: preferences.show-up-icon-toolbar
	type: bool
	default: true
	desc: Show Up button in nemo toolbar

field: preferences.size-prefixes
	type: string
	allowed: base-10, base-10-full, base-2, base-2-full
	default: base-2
	desc: Prefixes used for file sizes

field: preferences.sort-directories-first
	type: bool
	default: true
	desc: Show folders first in windows

field: preferences.sort-favorites-first
	type: bool
	default: true
	desc: Show favorites first in windows

field: preferences.start-with-dual-pane
	type: bool
	default: false
	desc: Whether to default to showing dual-pane view when a new window is opened

field: preferences.swap-trash-delete
	type: bool
	default: false
	desc: Whether to swap the hotkeys for Trash and Delete

field: preferences.tabs-open-position
	type: string
	allowed: after-current-tab, end
	default: after-current-tab
	desc: Where to position newly open tabs in browser windows.

field: preferences.thumbnail-limit
	type: int
	default: 1048576
	desc: Maximum image size for thumbnailing

field: preferences.thumbnail-threads
	type: int
	default: -1
	desc: Number of threads to dedicate to thumbnailing. -1 to let the program decide. The maximum allowed threads is half the number of logical processors, regardless of what is set here. If you change this setting you must restart Nemo for it to take effect.


<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Application manifest, embedded in the exe as resource 1 of type 24.

	Three things are declared here and nowhere else, because Windows reads them
	before any of our code runs:

	  - DPI awareness. Per-monitor v2 where Windows has it, falling back through
	    per-monitor v1 to system-wide on older builds. Without this the whole
	    window is bitmap-stretched on a scaled display, which is blurry, and a
	    second monitor at a different scale cannot be followed at all. GTK reads
	    the awareness we declare and does not try to set its own.
	  - Long paths. With this and the machine-wide switch both on, a path past
	    the old 260-character limit is reachable; without it we are held to
	    MAX_PATH while Explorer is not.
	  - The run-as level. asInvoker is what we already got by having no manifest
	    at all, stated explicitly so it cannot change by accident. Asking for
	    elevation is a deliberate act with its own relaunch.
	  - The process code page. Everything we call is the wide form of the API,
	    but the libraries under us and the C runtime are not, and without this
	    those fall back on whatever the machine happens to be set to - which is
	    how a user name outside that code page breaks things that otherwise
	    look fine.

	No common-controls dependency on purpose: nothing here draws with them, and
	pulling in the v6 assembly would change how the shell dialogs we do use look.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

	<assemblyIdentity type="win32"
	                  name="t00mietum.nemo-anywhere"
	                  version="1.0.0.0"
	                  processorArchitecture="*"/>

	<description>Nemo Anywhere file manager</description>

	<application xmlns="urn:schemas-microsoft-com:asm.v3">
		<windowsSettings>
			<!-- 1703 and later reads this one; the list is tried in order. -->
			<dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
			<!-- 8.1 through 1607 read this one instead. "true/pm" is per-monitor. -->
			<dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
			<longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
			<!-- 1903 and later. Older builds ignore it and keep the machine code page. -->
			<activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
		</windowsSettings>
	</application>

	<!--
		Declaring the versions we have been run on is what stops the version
		APIs reporting Windows 8 forever. Newest first.
	-->
	<compatibility xmlns="urn:schemas-microsoft-com:compat.v1">
		<application>
			<supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- 10 and 11 -->
			<supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- 8.1 -->
			<supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/> <!-- 8 -->
			<supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/> <!-- 7 -->
		</application>
	</compatibility>

	<trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
		<security>
			<requestedPrivileges>
				<requestedExecutionLevel level="asInvoker" uiAccess="false"/>
			</requestedPrivileges>
		</security>
	</trustInfo>

</assembly>

[Icon Theme]
Name=AdwaitaLegacy
Comment=Adwaita style, trimmed for nemo-anywhere
X-Nemo-Style=Adwaita
X-Nemo-Modes=light;dark
Inherits=hicolor
Example=folder
Directories=scalable/devices,scalable/emblems,scalable/mimetypes,scalable/places

[scalable/devices]
Size=48
MinSize=8
MaxSize=512
Context=Devices
Type=Scalable

[scalable/emblems]
Size=48
MinSize=8
MaxSize=512
Context=Emblems
Type=Scalable

[scalable/mimetypes]
Size=48
MinSize=8
MaxSize=512
Context=MimeTypes
Type=Scalable

[scalable/places]
Size=48
MinSize=8
MaxSize=512
Context=Places
Type=Scalable


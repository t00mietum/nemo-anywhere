[Icon Theme]
Name=Fluent
Comment=Windows 11 style (nemo-anywhere subset)
Inherits=Adwaita,hicolor
Example=folder

Directories=scalable/places,scalable/mimetypes,scalable/devices,symbolic/places,symbolic/devices,symbolic/emblems

[scalable/places]
Size=48
MinSize=8
MaxSize=512
Context=Places
Type=Scalable

[scalable/mimetypes]
Size=48
MinSize=8
MaxSize=512
Context=MimeTypes
Type=Scalable

[scalable/devices]
Size=48
MinSize=8
MaxSize=512
Context=Devices
Type=Scalable

[symbolic/places]
Size=16
MinSize=8
MaxSize=512
Context=Places
Type=Scalable

[symbolic/devices]
Size=16
MinSize=8
MaxSize=512
Context=Devices
Type=Scalable

[symbolic/emblems]
Size=16
MinSize=8
MaxSize=512
Context=Emblems
Type=Scalable

